{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StartLine Lane A Run Manifest",
  "type": "object",
  "required": ["runId", "policyId", "policyVersion", "sourcePolicyFileSha256", "canonicalPolicyObjectSha256", "codeCommitSha", "gitDirtyState", "sopSha256", "evaluationTimestamp", "mode", "sourceEvidenceMode", "preflight", "populationCounts", "outputArtifactHashes", "deviations", "finalDecisions", "postflight"],
  "properties": {
    "runId": { "type": "string" },
    "policyId": { "const": "startline-lane-a-sourcing-policy" },
    "policyVersion": { "type": "string" },
    "sourcePolicyFileSha256": { "type": "string" },
    "canonicalPolicyObjectSha256": { "type": "string" },
    "policyChecksumSemantics": { "type": "object" },
    "codeCommitSha": { "type": "string" },
    "codeCommitSource": { "type": "string" },
    "gitDirtyState": { "type": "object" },
    "sopSha256": { "type": "string" },
    "evaluationTimestamp": { "type": "string" },
    "mode": { "enum": ["fixture", "live-read-only"] },
    "sourceEvidenceMode": { "enum": ["FROZEN_SANITIZED_FIXTURE", "LIVE_READ_ONLY"] },
    "preflight": { "type": "object" },
    "populationCounts": { "type": "object" },
    "outputArtifactHashes": { "type": "object" },
    "deviations": { "type": "array" },
    "finalDecisions": { "type": "object" },
    "postflight": { "type": "object" }
  },
  "additionalProperties": true
}
