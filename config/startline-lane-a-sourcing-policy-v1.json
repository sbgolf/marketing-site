  "recurringCronCertificationRules": {
    "authorized": false,
    "minimumConsecutiveLiveReadOnlyRuns": 3,
    "requiresZeroUnresolvedDeviations": true,
    "requiresIndependentReview": true,
    "requiresSteveApproval": true
  }
