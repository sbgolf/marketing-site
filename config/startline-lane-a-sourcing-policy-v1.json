{
  "policyId": "startline-lane-a-sourcing-policy",
  "version": "1.0.0",
  "semanticVersion": "1.0.0",
  "targetSegment": "StartLine Sites Lane A Community-template race candidates",
  "allowedSourcePlatform": "RunSignup",
