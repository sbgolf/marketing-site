  ],
  "preflightRequirements": [
    "policy_checksum",
    "safety_jobs_enabled",
    "outbound_jobs_paused",
    "read_only_history_available",
    "no_send_credentials",
    "no_write_credentials",
    "private_output_path"
  ],
  "postflightRequirements": [
    "no_emails_sent",
    "no_contact_forms_submitted",
    "no_prospects_written",
    "no_mockups_created",
    "no_cron_state_changed",
    "no_database_mutation",
    "output_schema_valid",
    "counts_reconcile"
  ],
  "outputArtifacts": [
    "preflight-report.json",
    "source-evidence-validation.json",
    "rubric-scores.json",
    "sequential-waterfall.json",
    "owner-review-dossier.json",
    "deviation-register.json",
    "run-manifest.json",
    "postflight-no-side-effect-report.json"
