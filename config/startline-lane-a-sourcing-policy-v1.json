    "thresholds": {
      "HIGH": 15,
      "MEDIUM": 9,
      "LOW": 1
    },
    "components": [
      {
        "id": "standalone_site_gap",
        "weight": 3
      },
      {
        "id": "runsignup_completeness_gap",
        "weight": 2
      },
      {
        "id": "current_information_consistency",
        "weight": 2
      },
      {
        "id": "race_specific_brand_story_gap",
        "weight": 2
      },
      {
        "id": "sponsor_presentation_gap",
        "weight": 1
      },
      {
        "id": "routes_faq_logistics_gap",
        "weight": 2
      },
      {
        "id": "year_round_seo_gap",
        "weight": 2
      },
      {
        "id": "photos_media_gap",
        "weight": 1
      },
      {
        "id": "charity_donation_story_gap",
        "weight": 1
      },
      {
        "id": "contact_capture_gap",
        "weight": 1
      },
      {
        "id": "incremental_value_beyond_current_experience",
        "weight": 3
      }
    ],
    "rules": {
      "absenceOfUniqueDomainAloneCannotProduceHigh": true,
      "detailedRunSignupOrOfficialPageReducesNeed": true
    }
  },
  "commercialCapacityRubric": {
    "thresholds": {
      "HIGH": 13,
      "MEDIUM": 7,
      "LOW": 1
