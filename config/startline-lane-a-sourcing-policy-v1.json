    "components": [
      {
        "id": "recurring_event_history",
        "weight": 3
      },
      {
        "id": "paid_entry",
        "weight": 2
      },
      {
        "id": "participant_field_evidence",
        "weight": 2
      },
      {
        "id": "sponsors",
        "weight": 2
      },
      {
        "id": "organizer_type",
        "weight": 2
      },
      {
        "id": "multiple_distances",
        "weight": 1
      },
      {
        "id": "professional_marketing_media",
        "weight": 1
      },
      {
        "id": "fundraising",
        "weight": 1
      },
      {
        "id": "operational_scale",
        "weight": 2
      }
    ]
  },
